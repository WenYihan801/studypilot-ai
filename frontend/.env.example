# Copy to .env.local. These values are PUBLIC by design (they ship to the browser).
# Never put the Supabase secret key or the Gemini API key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Local dev: leave empty to use the Vite proxy (/api -> http://127.0.0.1:8000).
# Production (Vercel): the Render URL, e.g. https://studypilot-api.onrender.com
VITE_API_BASE_URL=
