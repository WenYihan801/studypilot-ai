# Copy to backend/.env for local development. NEVER commit .env.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# supabase | memory (memory = in-process store used by tests)
DATA_BACKEND=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Secret key (bypasses RLS) — backend only. Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
STORAGE_BUCKET=documents

# gemini | mock  (use mock while developing UI or when the free quota is exhausted)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_QUIZ_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match vector(768) in supabase/migrations. Changing it requires a new migration + re-embedding.
EMBEDDING_DIM=768

# RAG tuning (validate changes with: uv run python -m eval.run_eval)
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3

# Limits
MAX_UPLOAD_MB=20
DAILY_AI_REQUEST_LIMIT=100
DAILY_UPLOAD_LIMIT=30
AI_RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_MINUTE=60
